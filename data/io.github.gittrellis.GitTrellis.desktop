[Desktop Entry]
Type=Application
Name=GitTrellis
GenericName=Git Client
Comment=Browse repositories, stage changes and manage branches
Exec=gittrellis %F
Icon=io.github.gittrellis.GitTrellis
Terminal=false
Categories=Development;RevisionControl;
Keywords=git;vcs;version control;commit;branch;repository;
StartupNotify=true
StartupWMClass=io.github.gittrellis.GitTrellis
DBusActivatable=false
MimeType=inode/directory;
